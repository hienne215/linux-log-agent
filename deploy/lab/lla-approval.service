[Unit]
Description=Linux Log Agent lab-only approval coordinator
After=lla-helper.service systemd-tmpfiles-setup.service
Requires=lla-helper.service
BindsTo=lla-helper.service
ConditionHost=linux-log-lab-hien
ConditionVirtualization=kvm

[Service]
Type=notify
NotifyAccess=main
User=lla-approval
Group=lla-approval
# Only the trusted coordinator may create/chgrp its two role-specific sockets.
SupplementaryGroups=mcp-log-reader lla-operator
ExecStart=/opt/linux-log-agent/runtime/bin/python -I -B -m control_plane.runtime approval
WorkingDirectory=/var/lib/linux-log-agent/approval
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/linux-log-agent/proposal /run/linux-log-agent/control /var/lib/linux-log-agent/approval
TimeoutStartSec=15
TimeoutStopSec=15
KillMode=control-group
Restart=no
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
