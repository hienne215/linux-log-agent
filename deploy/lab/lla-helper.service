[Unit]
Description=Linux Log Agent lab-only bounded helper
After=dbus.service systemd-tmpfiles-setup.service
Requires=dbus.service
ConditionHost=linux-log-lab-hien
ConditionVirtualization=kvm

[Service]
Type=notify
NotifyAccess=main
User=root
Group=lla-approval
ExecStart=/opt/linux-log-agent/runtime/bin/python -I -B -m control_plane.runtime helper
WorkingDirectory=/var/lib/linux-log-agent/helper
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/linux-log-agent/helper /var/lib/linux-log-agent/helper
TimeoutStartSec=15
TimeoutStopSec=45
KillMode=control-group
Restart=no
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
