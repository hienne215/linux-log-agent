#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
PYTHON=${LINUX_LOG_AGENT_PYTHON:-"$ROOT/.venv/bin/python"}
if [ ! -x "$PYTHON" ]; then
    printf '%s\n' 'Python runtime chưa sẵn sàng. Xem docs/READ_ONLY_AGENT.md.' >&2
    exit 1
fi
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
exec "$PYTHON" -B -m agent.read_only "$@"
