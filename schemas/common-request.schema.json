{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common-request.schema.json",
  "title": "Common MCP Request Metadata",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "trace_id"
  ]
}