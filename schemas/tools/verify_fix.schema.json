{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verify_fix Request",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "logical_tool_call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*\\.service$"
    },
    "since": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "Z$"
    },
    "check_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "service_active",
          "no_new_failures",
          "port_listening"
        ]
      }
    },
    "action_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "baseline_evidence_refs": {
      "type": [
        "array",
        "null"
      ],
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "trace_id",
    "logical_tool_call_id",
    "attempt_id",
    "unit",
    "since",
    "check_types"
  ],
  "additionalProperties": false
}
