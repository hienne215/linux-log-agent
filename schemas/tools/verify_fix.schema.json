
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verify_fix Request",
  "allOf": [
    {
      "$ref": "../common-request.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_.@-]+\\.service$"
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "until": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "Z$"
        },
        "check_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "service_active",
              "no_new_failures",
              "port_listening"
            ]
          }
        },
        "action_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "baseline_evidence_refs": {
          "type": ["array", "null"],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "unit",
        "since",
        "check_types"
      ]
    }
  ],
  "unevaluatedProperties": false
}
