{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "restart_service Response Data",
  "description": "Response data schema for restart_service. This tool only creates or inspects restart proposals and never executes a real restart.",
  "oneOf": [
    {
      "title": "Proposal created",
      "type": "object",
      "properties": {
        "proposal_status": {
          "const": "pending_approval"
        },
        "reason": {
          "type": "string",
          "maxLength": 512
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "executed": {
          "const": false
        },
        "message": {
          "type": "string",
          "maxLength": 2048
        },
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "action_id",
        "proposal_status",
        "reason",
        "evidence_ids",
        "executed",
        "message",
        "expires_at"
      ],
      "additionalProperties": false
    },
    {
      "title": "Proposal status",
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "proposal_status": {
          "type": "string",
          "enum": [
            "pending_approval",
            "denied",
            "expired",
            "approved",
            "executing",
            "succeeded",
            "failed",
            "execution_unknown"
          ]
        },
        "executed": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "maxLength": 2048
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "action_id",
        "proposal_status",
        "executed",
        "message",
        "expires_at"
      ],
      "additionalProperties": false
    }
  ]
}
