
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linux-log-agent.local/schemas/tools/restart_service.schema.json",
  "title": "restart_service Request",
  "description": "Request to propose a service restart. This tool does not execute the restart directly and requires approval.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "logical_tool_call_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "description": "Target systemd service unit."
    },
    "mode": {
  "type": "string",
  "enum": ["propose", "status"],
  "description": "propose creates a restart proposal; status reads its status. Neither mode executes a restart."
},
"evidence_ids": {
  "type": "array",
  "items": {
    "type": "string",
    "minLength": 1
  },
  "description": "Evidence references supporting the restart proposal."
},
"action_id": {
  "type": "string",
  "minLength": 1,
  "description": "Proposal identifier required when mode is status."
},
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "Reason for proposing the service restart."
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "trace_id",
    "logical_tool_call_id",
    "attempt_id",
    "unit",
    "mode",
    "reason"
  ],
  "additionalProperties": false
}
