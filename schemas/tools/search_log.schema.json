{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search_log Request",
  "allOf": [
    {
      "$ref": "../common-request.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "until": {
          "type": "string",
          "format": "date-time"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 100
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "source_id",
        "query",
        "since",
        "until"
      ]
    }
  ],
  "unevaluatedProperties": false
}