{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search_log Request",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "logical_tool_call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "since": {
      "type": "string",
      "format": "date-time"
    },
    "until": {
      "type": "string",
      "format": "date-time"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 100
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "trace_id",
    "logical_tool_call_id",
    "attempt_id",
    "source_id",
    "query",
    "since",
    "until"
  ],
  "additionalProperties": false
}
