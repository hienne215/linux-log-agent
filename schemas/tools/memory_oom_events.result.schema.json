{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memory_oom_events Structured Result",
  "description": "Common response envelope for all Linux Log Agent MCP tools.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "logical_tool_call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tool": {
      "const": "memory_oom_events"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "error",
        "approval_required"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "excerpt": {
            "type": "string"
          },
          "redacted": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "evidence_id",
          "observed_at",
          "unit",
          "source",
          "excerpt",
          "redacted",
          "truncated"
        ],
        "additionalProperties": false
      }
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "INVALID_INPUT",
        "PERMISSION_DENIED",
        "TIMEOUT",
        "OUTPUT_LIMIT",
        "NOT_FOUND",
        "UNSUPPORTED",
        "POLICY_DENIED",
        "APPROVAL_REQUIRED",
        "EXPIRED",
        "REPLAY",
        "HELPER_UNAVAILABLE",
        "EXECUTION_UNKNOWN",
        null
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "trace_id",
    "logical_tool_call_id",
    "attempt_id",
    "tool",
    "status",
    "started_at",
    "completed_at",
    "duration_ms",
    "data",
    "evidence",
    "error_code",
    "truncated",
    "next_cursor"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "approval_required"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error_code": {
            "const": "APPROVAL_REQUIRED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          },
          "error_code": {
            "enum": [
              null,
              "OUTPUT_LIMIT"
            ]
          }
        },
        "required": [
          "status",
          "error_code"
        ]
      },
      "then": {}
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "max_response_bytes": {
                "const": 65536
              }
            },
            "required": [
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "memory_oom_events Response Data",
            "type": "object",
            "properties": {
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "process": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "timestamp",
                    "process",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              }
            },
            "required": [
              "events",
              "count",
              "limit"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
