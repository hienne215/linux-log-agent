{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "query_journal Request",
  "description": "Query journal events using bounded filters and cursor pagination.",
  "allOf": [
    {
      "$ref": "../common-request.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_.@-]+\\.service$"
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "until": {
          "type": "string",
          "format": "date-time"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 100
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "unit",
        "since",
        "until"
      ]
    }
  ],
  "unevaluatedProperties": false
}