{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "list_failed_units Request",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "logical_tool_call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 100
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "trace_id",
    "logical_tool_call_id",
    "attempt_id"
  ],
  "additionalProperties": false
}
