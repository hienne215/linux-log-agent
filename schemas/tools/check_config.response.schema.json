{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "check_config Response Data",
  "description": "Response data schema for the check_config MCP tool.",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "unit": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "valid": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "message": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "required": [
    "profile",
    "unit",
    "valid",
    "issues",
    "message"
  ],
  "additionalProperties": false
}
