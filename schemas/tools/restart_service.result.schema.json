{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "restart_service Structured Result",
  "description": "Common response envelope for all Linux Log Agent MCP tools.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "logical_tool_call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tool": {
      "const": "restart_service"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "error",
        "approval_required"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "excerpt": {
            "type": "string",
            "maxLength": 2048
          },
          "redacted": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "evidence_id",
          "observed_at",
          "unit",
          "source",
          "excerpt",
          "redacted",
          "truncated"
        ],
        "additionalProperties": false
      }
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "INVALID_INPUT",
        "PERMISSION_DENIED",
        "TIMEOUT",
        "OUTPUT_LIMIT",
        "NOT_FOUND",
        "UNSUPPORTED",
        "POLICY_DENIED",
        "APPROVAL_REQUIRED",
        "EXPIRED",
        "REPLAY",
        "HELPER_UNAVAILABLE",
        "EXECUTION_UNKNOWN",
        null
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "trace_id",
    "logical_tool_call_id",
    "attempt_id",
    "tool",
    "status",
    "started_at",
    "completed_at",
    "duration_ms",
    "data",
    "evidence",
    "error_code",
    "truncated",
    "next_cursor"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "approval_required"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error_code": {
            "const": "APPROVAL_REQUIRED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          },
          "error_code": {
            "enum": [
              null,
              "OUTPUT_LIMIT"
            ]
          }
        },
        "required": [
          "status",
          "error_code"
        ]
      },
      "then": {}
    },
    {
      "if": {
        "properties": {
          "truncated": {
            "const": true
          }
        },
        "required": [
          "truncated"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "maxLength": 2048
              },
              "field": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "max_response_bytes": {
                "const": 65536
              },
              "coverage": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "status": {
                      "enum": [
                        "ok",
                        "permission_denied",
                        "unavailable"
                      ]
                    },
                    "oldest_available_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "source",
                    "status",
                    "oldest_available_at"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "message"
            ],
            "additionalProperties": false,
            "$schema": "https://json-schema.org/draft/2020-12/schema"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "restart_service Response Data",
            "description": "Response data schema for restart_service. This tool only creates or inspects restart proposals and never executes a real restart.",
            "oneOf": [
              {
                "title": "Proposal created",
                "type": "object",
                "properties": {
                  "proposal_status": {
                    "const": "pending_approval"
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "minItems": 1,
                    "maxItems": 32,
                    "uniqueItems": true
                  },
                  "executed": {
                    "const": false
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "action_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "unit": {
                    "type": "string",
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*\\.service(?![\\s\\S])"
                  }
                },
                "required": [
                  "action_id",
                  "proposal_status",
                  "reason",
                  "evidence_ids",
                  "executed",
                  "message",
                  "expires_at",
                  "unit"
                ],
                "additionalProperties": false
              },
              {
                "title": "Proposal status",
                "type": "object",
                "properties": {
                  "action_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "proposal_status": {
                    "type": "string",
                    "enum": [
                      "pending_approval",
                      "denied",
                      "expired",
                      "approved",
                      "executing",
                      "succeeded",
                      "failed",
                      "execution_unknown"
                    ]
                  },
                  "executed": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "unit": {
                    "type": "string",
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*\\.service(?![\\s\\S])"
                  }
                },
                "required": [
                  "action_id",
                  "proposal_status",
                  "executed",
                  "message",
                  "expires_at",
                  "unit"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "proposal_status": {
                          "const": "execution_unknown"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "executed": {
                          "type": "null"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "executed": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
