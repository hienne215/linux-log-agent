{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "listening_ports Response Data",
  "type": "object",
  "properties": {
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "address": {
            "type": "string",
            "maxLength": 128
          },
          "process": {
            "type": "string",
            "maxLength": 2048
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          }
        },
        "required": [
          "protocol",
          "port",
          "address",
          "process",
          "unit"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "ports",
    "count"
  ],
  "additionalProperties": false
}
