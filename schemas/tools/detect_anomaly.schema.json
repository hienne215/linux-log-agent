{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "detect_anomaly Request",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "logical_tool_call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*\\.service$",
      "maxLength": 128
    },
    "since": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "until": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "signals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "service_failures",
          "journal_errors",
          "oom_events",
          "failed_logins"
        ]
      }
    },
    "max_findings": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 20
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "trace_id",
    "logical_tool_call_id",
    "attempt_id",
    "since",
    "until"
  ],
  "additionalProperties": false
}
