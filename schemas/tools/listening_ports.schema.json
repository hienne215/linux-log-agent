{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "listening_ports request",
  "description": "Request to list listening network ports.",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "enum": [
        "tcp",
        "udp"
      ],
      "description": "Filter by network protocol."
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "Filter by port number."
    },
    "unit": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*\\.service$",
      "description": "Optional service unit filter.",
      "maxLength": 128
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "logical_tool_call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "trace_id",
    "logical_tool_call_id",
    "attempt_id"
  ],
  "additionalProperties": false
}
