{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "check_config request",
  "description": "Request to validate a system configuration using a fixed profile.",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "enum": [
        "ssh",
        "firewall",
        "systemd"
      ],
      "description": "Predefined configuration validation profile."
    },
    "unit": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*\\.service$",
      "description": "Optional service unit to validate.",
      "maxLength": 128
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "logical_tool_call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "profile",
    "schema_version",
    "session_id",
    "trace_id",
    "logical_tool_call_id",
    "attempt_id"
  ],
  "additionalProperties": false
}
