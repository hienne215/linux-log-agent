{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memory_oom_events Response Data",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "process": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          "message": {
            "type": "string",
            "maxLength": 2048
          },
          "pid": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "anon_rss_kb": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "total_vm_kb": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "timestamp",
          "process",
          "message",
          "pid"
        ],
        "additionalProperties": false
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "ok",
              "permission_denied",
              "unavailable"
            ]
          },
          "oldest_available_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "source",
          "status",
          "oldest_available_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "events",
    "count",
    "limit",
    "coverage"
  ],
  "additionalProperties": false
}
