{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search_log Response Data",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_-]*(?![\\s\\S])"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "message": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "timestamp",
          "message"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  },
  "required": [
    "source_id",
    "query",
    "matches",
    "count",
    "limit"
  ],
  "additionalProperties": false
}
