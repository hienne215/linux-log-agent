{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "detect_anomaly Structured Result",
  "description": "Common response envelope for all Linux Log Agent MCP tools.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "logical_tool_call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tool": {
      "const": "detect_anomaly"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "error",
        "approval_required"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "excerpt": {
            "type": "string"
          },
          "redacted": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "evidence_id",
          "observed_at",
          "unit",
          "source",
          "excerpt",
          "redacted",
          "truncated"
        ],
        "additionalProperties": false
      }
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "INVALID_INPUT",
        "PERMISSION_DENIED",
        "TIMEOUT",
        "OUTPUT_LIMIT",
        "NOT_FOUND",
        "UNSUPPORTED",
        "POLICY_DENIED",
        "APPROVAL_REQUIRED",
        "EXPIRED",
        "REPLAY",
        "HELPER_UNAVAILABLE",
        "EXECUTION_UNKNOWN",
        null
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "trace_id",
    "logical_tool_call_id",
    "attempt_id",
    "tool",
    "status",
    "started_at",
    "completed_at",
    "duration_ms",
    "data",
    "evidence",
    "error_code",
    "truncated",
    "next_cursor"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "approval_required"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error_code": {
            "const": "APPROVAL_REQUIRED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          },
          "error_code": {
            "enum": [
              null,
              "OUTPUT_LIMIT"
            ]
          }
        },
        "required": [
          "status",
          "error_code"
        ]
      },
      "then": {}
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "max_response_bytes": {
                "const": 65536
              }
            },
            "required": [
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "detect_anomaly Response Data",
            "type": "object",
            "properties": {
              "anomalies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "service_failures",
                        "journal_errors",
                        "oom_events",
                        "failed_logins"
                      ]
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "critical"
                      ]
                    },
                    "summary": {
                      "type": "string"
                    },
                    "observed_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "window": {
                      "type": "object",
                      "properties": {
                        "since": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "Z$"
                        },
                        "until": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "Z$"
                        }
                      },
                      "required": [
                        "since",
                        "until"
                      ],
                      "additionalProperties": false
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "detection_method": {
                      "type": "string",
                      "enum": [
                        "rule_based"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "severity",
                    "summary",
                    "observed_count",
                    "window",
                    "evidence_refs",
                    "detection_method"
                  ],
                  "additionalProperties": false
                }
              },
              "analyzed_signals": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "service_failures",
                    "journal_errors",
                    "oom_events",
                    "failed_logins"
                  ]
                }
              },
              "insufficient_signals": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "findings_truncated": {
                "type": "boolean"
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "anomalies",
              "analyzed_signals",
              "insufficient_signals",
              "findings_truncated",
              "confidence"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
