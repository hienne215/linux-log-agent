{
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "maxLength": 2048
    },
    "field": {
      "type": "string"
    },
    "rule": {
      "type": "string"
    },
    "max_response_bytes": {
      "const": 65536
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "ok",
              "permission_denied",
              "unavailable"
            ]
          },
          "oldest_available_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "source",
          "status",
          "oldest_available_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "message"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
